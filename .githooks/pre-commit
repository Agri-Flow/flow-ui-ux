#!/usr/bin/env sh
#
# flow-ui pre-commit gate (static HTML repo — no npm/husky).
# Guards the PROMOTED design contract: runs the canonical 24-gate linter
# (.claude/scripts/lint-prototypes.sh) on staged PROMOTED screens
# (ui-flow/agriflow-rwanda-design-system/project/screens/*.html — the single source of
# truth flow-fe consumes) and blocks the commit if any is not clean (the script prints
# a trailing "NO" = P0>0 or P1>0). Mirrors the deterministic G10 gate in
# .github/workflows/ci.yml so green-locally = green-in-CI.
#
# Staging prototypes (ui-flow/e{N}-*/) are intentionally NOT gated here — staging is an
# iterative workshop, allowed to be incomplete until `design-builder promote` runs
# G10+G12. Staging stays covered (advisory) by design-builder Phase 5.5 + pr-reviewer.
#
# Enable once per clone:   git config core.hooksPath .githooks
# Override (discouraged):  git commit --no-verify
#

# Protected-branch guard — main receives merges via PR only.
CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD)"
if [ "$CURRENT_BRANCH" = "main" ]; then
  echo "  ✖ Direct commits to 'main' are blocked — branch + PR instead (override: --no-verify)."
  exit 1
fi

# Staged PROMOTED screens only (added/copied/modified). Promoted files should change
# via `design-builder promote`, not hand-edits — this catches a hand-edit that drifts.
FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^ui-flow/agriflow-rwanda-design-system/project/screens/.*\.html$' || true)
if [ -z "$FILES" ]; then
  exit 0
fi

echo "→ design-lint (G10) on staged promoted screens…"
# Write per-file reports under .git/ so commits never generate tracked report files.
REPORTS_DIR="$(git rev-parse --show-toplevel)/.git/precommit-ux-reports"
mkdir -p "$REPORTS_DIR"
OUT=$(REPORTS_DIR="$REPORTS_DIR" bash .claude/scripts/lint-prototypes.sh $FILES)
echo "$OUT"
if echo "$OUT" | grep -qE '[[:space:]]NO$'; then
  echo "  ✖ Design-system gate G10 failed — a PROMOTED screen is not clean (P0>0 or P1>0)."
  echo "    Promoted screens are the contract; fix via design-builder, not a hand-edit (override: git commit --no-verify)."
  exit 1
fi
echo "✓ design-lint passed"
